# Copy to .env. Keep secrets out of source control and chat.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/blackmamer?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/blackmamer?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
# One-time owner bootstrap; remove password after running seed.
OWNER_EMAIL=""
OWNER_PASSWORD=""
OWNER_NAME="BLACKMAMERSTUDIO"
# Development portfolio examples only. Never creates fake customers/orders.
SEED_DEMO="false"
# Sandbox by default. Keep server key on server.
MIDTRANS_SERVER_KEY=""
MIDTRANS_PRODUCTION="false"
# Public portfolio media store (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
# Optional small private Blob delivery; use S3 for large downloadable products.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
# Private S3-compatible storage, e.g. R2/S3. Browser CORS must allow your origin + PUT.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Transactional email
RESEND_API_KEY=""
EMAIL_FROM="BLACKMAMERSTUDIO <studio@your-verified-domain.com>"
ADMIN_EMAIL=""
# Optional paired bot protection keys
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Protect scheduled maintenance endpoint; generate separately from NEXTAUTH_SECRET.
CRON_SECRET=""
